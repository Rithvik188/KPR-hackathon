# Copy to .env (never commit .env). Both laptops must use the SAME two secrets so seeded
# duplicate HMACs and encrypted images are interchangeable. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_HMAC_SECRET=
IMAGE_ENC_KEY=
DATABASE_URL=sqlite:///./data/sevaicheck.db
DATA_DIR=./data
# easyocr | rapidocr
OCR_ENGINE=easyocr
# auto (use CUDA if available) | 0 (force CPU) | 1 (force GPU)
OCR_GPU=auto
OCR_WARMUP=1
# 1 = FastAPI also serves web/dist at / (production build, single port for ngrok)
SERVE_WEB=0
