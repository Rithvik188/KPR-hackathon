# Copy to .env (never commit .env). Both laptops must use the SAME two secrets so seeded
# duplicate HMACs and encrypted images are interchangeable. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_HMAC_SECRET=
IMAGE_ENC_KEY=
DATABASE_URL=sqlite:///./data/sevaicheck.db
DATA_DIR=./data
# rapidocr (default: CPU ONNX, models ship in the wheel) | easyocr (needs model download from GitHub)
OCR_ENGINE=rapidocr
# auto (use CUDA if available) | 0 (force CPU) | 1 (force GPU)
OCR_GPU=auto
OCR_WARMUP=1
# 1 = FastAPI also serves web/dist at / (production build, single port for ngrok)
SERVE_WEB=0

# --- Security (docs/SECURITY.md) ---
# 1 (default) = every non-public API route needs a signed session token. 0 only for local development.
AUTH_REQUIRED=1
# Password of the demo staff accounts (VAO/RI/Tahsildar/operators). At least 10 characters. Share privately.
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
STAFF_DEMO_PASSWORD=
# The prototype has no SMS gateway: 1 returns the citizen OTP in the API response (demo only).
DEMO_OTP_IN_RESPONSE=1
